---
import ModelLayout from "@/layouts/ModelLayout.astro";
import { Image } from "astro:assets";
import contactImage from "@/assets/model/contact_image.jpg";

const widths = [640, 1080, 1376].filter((w) => w <= contactImage.width);
if (widths.length === 0) widths.push(contactImage.width);
---

<ModelLayout>
  <div class="grid gap-10 md:grid-cols-2 md:items-start">
    <div class="relative w-full overflow-hidden md:h-[50vh]">
      <Image
        src={contactImage}
        alt="William Gunn"
        widths={widths}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>

    <form id="contact-form" class="flex w-full flex-col gap-4">
      <label class="flex flex-col gap-1">
        <span class="text-sm uppercase tracking-wide">Name</span>
        <input
          type="text"
          name="name"
          required
          class="border-b border-current bg-transparent py-2 outline-none focus:border-b-2"
        />
      </label>

      <label class="flex flex-col gap-1">
        <span class="text-sm uppercase tracking-wide">Email</span>
        <input
          type="email"
          name="email"
          required
          class="border-b border-current bg-transparent py-2 outline-none focus:border-b-2"
        />
      </label>

      <label class="flex flex-col gap-1">
        <span class="text-sm uppercase tracking-wide">Message</span>
        <textarea
          name="message"
          rows="5"
          required
          class="resize-none border-b border-current bg-transparent py-2 outline-none focus:border-b-2"
        ></textarea>
      </label>

      <button
        type="submit"
        class="mt-2 self-start border border-current px-6 py-2 uppercase tracking-wide transition-colors hover:bg-white hover:text-black"
      >
        Send Message
      </button>
    </form>
  </div>
</ModelLayout>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const name = String(data.get("name") ?? "");
    const email = String(data.get("email") ?? "");
    const message = String(data.get("message") ?? "");

    const subject = encodeURIComponent(`Portfolio inquiry from ${name}`);
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\n\n${message}`,
    );

    window.location.href = `mailto:wwwillgunnn@gmail.com?subject=${subject}&body=${body}`;
  });
</script>
