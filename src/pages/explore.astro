---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/model/Navbar";
import SpaceScene from "@/components/explore/SpaceScene";
import "@fontsource/playfair-display/400.css";
import "@fontsource/playfair-display/500.css";
import "@fontsource/playfair-display/600.css";
---

<BaseLayout
  title="William Gunn - Explore"
  description="An interactive 3D space environment."
>
  <div class="relative h-screen w-full overflow-hidden bg-[#05060f] text-white">
    <SpaceScene client:only="react" />

    <header class="pointer-events-none absolute inset-x-0 top-0 flex justify-center p-6 font-playfair">
      <div class="pointer-events-auto">
        <Navbar client:load />
      </div>
    </header>

    <div
      class="pointer-events-none absolute inset-x-0 bottom-8 text-center"
      aria-hidden="true"
    >
      <h1 class="font-playfair text-3xl tracking-wide sm:text-4xl">Explore</h1>
      <p class="mt-2 text-sm text-white/60">Drag to orbit · scroll to zoom</p>
    </div>
  </div>
</BaseLayout>
