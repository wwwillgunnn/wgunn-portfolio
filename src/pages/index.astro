---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChromeObject from "@/components/canvasui/ChromeObject";
import LightRays from "@/components/reactbits/LightRays";
---

<BaseLayout title="William Gunn - Portfolio">
  <main class="relative flex min-h-screen flex-col items-center justify-center gap-6 overflow-hidden bg-[#0a0a0a] p-8 text-center text-zinc-100">
    <div
      class="absolute inset-0 z-0 opacity-55 [&_canvas]:block [&_canvas]:h-full [&_canvas]:w-full"
      aria-hidden="true"
    >
      <LightRays
        client:load
        raysOrigin="top-center"
        raysColor="#dbeafe"
        followMouse={true}
        style={{}}
      />
    </div>
    <div
      class="pointer-events-none absolute inset-0 z-1 bg-[radial-gradient(ellipse_at_50%_45%,rgba(10,10,10,0.35)_0%,#0a0a0a_85%)]"
      aria-hidden="true"
    ></div>
    <div
      class="grain pointer-events-none absolute inset-0 z-2 opacity-[0.07] mix-blend-overlay"
      aria-hidden="true"
    ></div>

    <h1 class="relative z-10 animate-[rise_0.9s_cubic-bezier(0.2,0.8,0.2,1)_both] bg-linear-to-b from-white from-30% to-zinc-500 bg-clip-text text-5xl font-semibold tracking-tight text-transparent motion-reduce:animate-none sm:text-8xl">
      William Gunn
    </h1>
    <p class="relative z-10 max-w-md text-lg text-zinc-400">
      A collection of my work, projects, and experiences.
    </p>

    <div class="choices relative z-10 mt-4 grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
      <div class="card group relative z-10 flex flex-col items-center gap-3 rounded-[2rem] border border-transparent px-4 pt-4 pb-6 transition-[scale,opacity,background-color,border-color] duration-500 ease-[cubic-bezier(0.2,0.8,0.2,1)] hover:scale-[1.04] hover:border-white/10 hover:bg-[radial-gradient(circle_at_50%_35%,rgba(229,231,235,0.16),transparent_70%)] motion-reduce:transition-none">
        <ChromeObject
          client:visible
          src="/renders/Macintosh.png"
          className="h-72 w-full sm:h-96"
          scale={3}
          floatIntensity={0.6}
          rotationIntensity={0.5}
          highlight="#066aff"
        />
        <a
          href="/dev"
          class="-mt-6 inline-flex h-12 min-w-48 items-center justify-center gap-2 rounded-full border border-white/15 px-6 font-medium transition-[background-color,color,min-width] duration-300 group-hover:min-w-56 group-hover:bg-white group-hover:text-[#0a0a0a] motion-reduce:transition-none"
        >
          Dev
          <i class="inline-block w-0 -translate-x-2 not-italic opacity-0 transition-all duration-300 group-hover:w-4 group-hover:translate-x-0 group-hover:opacity-100 motion-reduce:transition-none">
            →
          </i>
        </a>
        <span class="-translate-y-1.5 text-[0.8rem] tracking-[0.08em] text-zinc-400 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 motion-reduce:transition-none">
          apps · code · experiments
        </span>
      </div>

      <div class="card group relative z-10 flex flex-col items-center gap-3 rounded-[2rem] border border-transparent px-4 pt-4 pb-6 transition-[scale,opacity,background-color,border-color] duration-500 ease-[cubic-bezier(0.2,0.8,0.2,1)] hover:scale-[1.04] hover:border-white/10 hover:bg-[radial-gradient(circle_at_50%_35%,rgba(229,231,235,0.16),transparent_70%)] motion-reduce:transition-none">
        <ChromeObject
          client:visible
          src="/renders/Me.png"
          className="h-72 w-full sm:h-96"
          scale={3}
          floatIntensity={0.6}
          rotationIntensity={0.5}
          highlight="#e5e7eb"
        />
        <a
          href="/model"
          class="-mt-6 inline-flex h-12 min-w-48 items-center justify-center gap-2 rounded-full border border-white/15 px-6 font-medium transition-[background-color,color,min-width] duration-300 group-hover:min-w-56 group-hover:bg-white group-hover:text-[#0a0a0a] motion-reduce:transition-none"
        >
          Model
          <i class="inline-block w-0 -translate-x-2 not-italic opacity-0 transition-all duration-300 group-hover:w-4 group-hover:translate-x-0 group-hover:opacity-100 motion-reduce:transition-none">
            →
          </i>
        </a>
        <span class="-translate-y-1.5 text-[0.8rem] tracking-[0.08em] text-zinc-400 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 motion-reduce:transition-none">
          shoots · looks · editorial
        </span>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .choices:has(.card:hover) .card:not(:hover) {
    opacity: 0.3;
    scale: 0.94;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(8px);
    }
  }
  .grain {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
</style>
