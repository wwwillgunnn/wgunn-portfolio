---
import DevLayout from "@/layouts/DevLayout.astro";
---

<DevLayout
  title="Contact - William Gunn"
  description="Contact William Gunn about software, design, and project collaborations."
>
  <section class="py-12 sm:pt-10 sm:pb-0">
    <h1 class="my-4 text-3xl font-semibold tracking-tight">Contact</h1>
    <p class="mb-6 text-sm text-black/60 dark:text-white/60">
      Have a question or want to work together? Send me a message.
    </p>

    <form action="/api/contact" method="POST">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <input
          type="text"
          name="name"
          placeholder="Name"
          aria-label="Name"
          autocomplete="name"
          required
          class="mb-4 w-full rounded-lg border border-solid border-black/8 p-2 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]"
        />

        <input
          type="email"
          name="email"
          placeholder="Email"
          aria-label="Email"
          autocomplete="email"
          required
          class="mb-4 w-full rounded-lg border border-solid border-black/8 p-2 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]"
        />
      </div>

      <textarea
        name="message"
        placeholder="Message"
        aria-label="Message"
        required
        rows="6"
        class="mb-4 w-full rounded-lg border border-solid border-black/8 p-2 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]"
      />

      <button
        type="submit"
        class="w-full cursor-pointer rounded-lg border border-solid border-black/8 p-2 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]"
      >
        Send Message
      </button>
    </form>
  </section>
</DevLayout>
