---
import DevLayout from "@/layouts/DevLayout.astro";
---

<DevLayout
  title="Projects - William Gunn"
  description="Selected software, design, and interactive projects by William Gunn."
>
  <section class="py-12 sm:pt-10 sm:pb-0">
    <h1 class="my-4 text-3xl font-semibold tracking-tight">Projects</h1>

    <div class="grid grid-cols-2 gap-4">
      <button class="w-full h-80 border border-solid border-black/8 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]">
        project 1
      </button>

      <button class="w-full h-80 border border-solid border-black/8 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]">
        project 2
      </button>

      <button class="w-full h-80 border border-solid border-black/8 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]">
        project 3
      </button>

      <button class="w-full h-80 border border-solid border-black/8 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]">
        project 4
      </button>
    </div>

    <div class="mt-8 flex flex-row items-center justify-between">
      <a class="cursor-pointer flex items-center justify-center py-1 px-5 rounded-lg border border-solid border-black/8 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]">
        Back
      </a>
      <a class="cursor-pointer flex items-center justify-center py-1 px-5 rounded-lg border border-solid border-black/8 transition-colors hover:border-transparent hover:bg-black/[.04] dark:border-white/[.145] dark:hover:bg-[#1a1a1a]">
        Next
      </a>
    </div>
  </section>
</DevLayout>
