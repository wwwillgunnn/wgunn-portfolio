---
import BaseLayout from "@/layouts/BaseLayout.astro";
import sleepingWizard from "@/assets/dev/Ty_Test2.gif";
---

<BaseLayout title="William Gunn - Explore" description="Interactive World">
  <section class="min-h-screen flex flex-col items-center justify-center">
    <img src={sleepingWizard.src} alt="Sleeping Wizard" />
    <h1 class="absolute mt-80 text-4xl font-bold tracking-tight sm:text-8xl">
      Currently Casting Spells...
    </h1>
  </section>
</BaseLayout>
