---
import DevLayout from "@/layouts/DevLayout.astro";
---

<DevLayout
  title="William Gunn - Developer"
  description="Software, design, and interactive work by William Gunn."
>
  <section class="py-20 sm:py-28">
    <p class="font-mono text-xs uppercase text-zinc-500 dark:text-zinc-400">
      Software / Design / Interactive
    </p>
    <h1 class="mt-5 max-w-xl text-4xl font-semibold tracking-tight sm:text-5xl">
      I make apps and call them startups.
    </h1>
    <p class="mt-5 max-w-lg text-base leading-7 text-zinc-600 dark:text-zinc-400">
      A collection of software, design, and interactive work.
    </p>
  </section>
</DevLayout>
