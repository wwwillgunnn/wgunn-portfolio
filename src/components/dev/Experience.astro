---
import kpmgLogo from "@/assets/dev/companies/kpmg.png";
import dofLogo from "@/assets/dev/companies/dof.png";
import yicLogo from "@/assets/dev/companies/yic.png";
import chartertechLogo from "@/assets/dev/companies/ct.jpg";
import daffLogo from "@/assets/dev/companies/daff.jpg";

const experiences = [
  {
    company: "KPMG",
    role: "Technology Consultant",
    period: "Feb 2026 - Present",
    location: "Canberra, ACT",
    logo: kpmgLogo,
    responsibilities: [
      "Reduced manual processing time by 98% through workflow automation.",
      "Delivered scalable client automation solutions through workflow analysis and scripting.",
      "Introduced AI tools to automate repetitive tasks and improve team productivity.",
      "Supported ERP implementation and integration, translating business requirements into technical solutions.",
    ],
  },
  {
    company: "Department of Finance",
    role: "Service Desk Analyst",
    period: "Sep 2024 - Jan 2026",
    location: "Canberra, ACT",
    logo: dofLogo,
    responsibilities: [
      "Resolved 100+ weekly incidents across software, hardware and networking.",
      "Reduced resolution time by 20% through effective incident triaging and prioritisation.",
      "Managed secure user access across Active Directory, Azure DevOps and Jenkins.",
      "Developed self-service guides and chatbot solutions to reduce support requests.",
    ],
  },
  {
    company: "You.InControl",
    role: "Software Engineer",
    period: "Aug 2025 - Nov 2025",
    location: "Canberra, ACT",
    logo: yicLogo,
    responsibilities: [
      "Developed a Flask web app for real-time IoT monitoring, alerts and device control.",
      "Built a text and voice-enabled chatbot for natural-language device control.",
      "Integrated Arduino and Raspberry Pi systems through serial communication.",
    ],
  },
  {
    company: "Chartertech (Acquired by KPMG)",
    role: "ICT Intern",
    period: "Jun 2024 - Aug 2024",
    location: "Canberra, ACT",
    logo: chartertechLogo,
    responsibilities: [
      "Automated payroll leave processing using RPA, reducing manual work and errors.",
      "Designed 200+ test cases to improve system reliability and audit readiness.",
      "Documented and optimised business workflows using Holocentric.",
    ],
  },
  {
    company: "Department of Agriculture, Fisheries and Forestry",
    role: "Database Administrator",
    period: "Jan 2024 - Feb 2024",
    location: "Canberra, ACT",
    logo: daffLogo,
    responsibilities: [
      "Built a web scraper detecting thousands of illicit trading entries.",
      "Improved database performance and data accuracy through dataset optimisation.",
      "Automated data workflows to reduce manual handling and improve efficiency.",
    ],
  },
];
---

<section
  aria-label="Professional experience"
  class="relative w-full rounded-lg border-2 border-solid border-black/8 dark:border-white/[.145]"
>
  <!-- Timeline line -->
  <div class="absolute left-9.25 top-0 bottom-0 w-px bg-zinc-200 dark:bg-zinc-800 sm:left-9.75"></div>

  <div class="relative flex flex-col p-4">
    {experiences.map((job) => (
      <article class="group grid grid-cols-[44px_minmax(0,1fr)] gap-4 sm:grid-cols-[48px_minmax(0,1fr)] sm:gap-5">
        {/* Company logo */}
        <div class="relative z-10 flex items-start justify-center">
          <div class="flex size-11 shrink-0 items-center justify-center rounded-lg border border-black/[0.08] bg-white p-2 dark:border-white/[0.145] dark:bg-zinc-900 sm:size-12">
            <img
              src={job.logo.src}
              alt={`${job.company} logo`}
              class="size-full object-contain"
              loading="lazy"
            />
          </div>
        </div>

        {/* Experience details */}
        <div class="min-w-0 pb-8 pl-2 sm:pl-4">
          <h2 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 sm:text-2xl">
            {job.company}
          </h2>
          <div class="flex flex-col justify-between sm:flex-row sm:items-center">
            <p class="mt-1 text-base leading-7 text-zinc-600 dark:text-zinc-400">
              {job.role}
            </p>

            <div class="mt-1 flex flex-wrap items-center gap-x-2 text-sm text-zinc-500 dark:text-zinc-500">
              <span>{job.period}</span>
              <span aria-hidden="true">·</span>
              <span>{job.location}</span>
            </div>
          </div>
          <ul class="mt-3 max-w-2xl list-disc space-y-1.5 pl-5 text-sm leading-6 text-zinc-600 marker:text-zinc-400 dark:text-zinc-400 dark:marker:text-zinc-600">
            {job.responsibilities.map((responsibility) => (
              <li>{responsibility}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
