---
interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  repoLink: string;
  badges?: string[];
}

const { title, description, image, link, repoLink, badges } = Astro.props;
---

<div class="w-full p-2 sm:p-4 grid grid-cols-1fr rounded-lg border border-solid border-black/8 transition-colors dark:border-white/[.145]">
  <a href={link} target="_blank" rel="noopener noreferrer">
    <img
      src={image}
      alt={title}
      class="w-full h-full sm:max-h-40 object-cover object-center rounded-md"
    />
  </a>

  <div class="hidden sm:block mt-4">
    <!-- Text -->
    <h4 class="text-lg font-bold">{title}</h4>
    <p class="text-sm">{description}</p>

    <!-- Badges -->
    {badges && (
      <div class="mt-2 flex flex-wrap gap-2">
        {badges.map((badge) => (
          <span class="inline-block rounded-full bg-black/10 px-3 py-1 text-xs font-semibold text-black/60 dark:bg-white/[.145] dark:text-white/60">
            {badge}
          </span>
        ))}
      </div>
    )}

    <!-- Links -->
    <div class="flex flex-row gap-2 mt-4">
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View Project"
        class="flex flex-row gap-2 p-2 rounded-sm border border-solid border-black/8 transition-colors hover:border-transparent hover:bg-black/4 dark:border-white/[.145] dark:hover:bg-[#1a1a1a]"
      >
        <!-- <p>View Project</p> -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-external-link preview-icon"
        >
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </svg>
      </a>
      <a
        href={repoLink}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="flex flex-row gap-2 p-2 rounded-sm border border-solid border-black/8 transition-colors hover:border-transparent hover:bg-black/4 dark:border-white/[.145] dark:hover:bg-[#1a1a1a]"
      >
        <!-- <p>View Source</p> -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="text-black dark:text-white"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.11.82-.26.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.082-.73.082-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.304-5.466-1.332-5.466-5.93 0-1.31.468-2.38 1.235-3.22-.124-.303-.536-1.523.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.552 3.297-1.23 3.297-1.23.655 1.653.243 2.873.12 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.805 5.624-5.475 5.921.43.372.814 1.103.814 2.222v3.293c0 .32.216.694.825.576A12.003 12.003 0 0 0 24 12c0-6.63-5.37-12-12-12Z"
          />
        </svg>
      </a>
    </div>
  </div>
</div>
