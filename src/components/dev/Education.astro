---
const entries = [
  {
    institution: "Startmate",
    program: "Student Fellow",
    detail: "Winter '25 Cohort",
    period: "Jul 2025 - Aug 2025",
    category: "Education",
    logo: "/dev/ed-certs/startmate.png",
  },
  {
    institution: "University of Canberra",
    program: "Software Engineering",
    detail: "",
    period: "Feb 2023 - Nov 2025",
    category: "Education",
    logo: "/dev/ed-certs/uc.png",
  },
  {
    institution: "Automation Anywhere",
    program: "Bot Developer",
    detail: "",
    period: "Jul 2024",
    category: "Certificate",
    logo: "/dev/ed-certs/aa.avif",
  },
];
---

<section
  aria-label="Education and certifications"
  class="relative w-full rounded-lg border-2 border-solid border-black/8 dark:border-white/[.145]"
>
  <div class="absolute left-9.25 top-0 bottom-0 w-px bg-zinc-200 dark:bg-zinc-800 sm:left-9.75"></div>

  <div class="relative flex flex-col p-4">
    {entries.map((entry) => (
      <article class="group grid grid-cols-[44px_minmax(0,1fr)] gap-4 sm:grid-cols-[48px_minmax(0,1fr)] sm:gap-5">
        <div class="relative z-10 flex items-start justify-center">
          <div class="flex size-11 shrink-0 items-center justify-center rounded-lg border border-black/[0.08] bg-white p-2 dark:border-white/[0.145] dark:bg-zinc-900 sm:size-12">
            <img
              src={entry.logo}
              alt={`${entry.institution} logo`}
              class="size-full object-contain"
              loading="lazy"
            />
          </div>
        </div>

        <div class="min-w-0 pb-8 pl-2 sm:pl-4">
          <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-center">
            <h2 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 sm:text-2xl">
              {entry.institution}
            </h2>
            <span class="w-fit rounded-full border border-black/10 px-3 py-1 text-xs font-medium text-zinc-600 dark:border-white/[.145] dark:text-zinc-300">
              {entry.category}
            </span>
          </div>
          <div class="flex flex-col justify-between sm:flex-row sm:items-center">
            <p class="mt-1 text-base leading-7 text-zinc-600 dark:text-zinc-400">
              {entry.program}
              {entry.detail && <span> · {entry.detail}</span>}
            </p>

            <span class="mt-1 text-sm text-zinc-500 dark:text-zinc-500">
              {entry.period}
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
