---
interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  cursorReplacement: string;
  darkCursorReplacement?: string;
}

const {
  title,
  description,
  image,
  link,
  cursorReplacement,
  darkCursorReplacement = cursorReplacement,
} = Astro.props;
---

<div
  class="special-card w-full rounded-lg border border-black/8 dark:border-white/[.145] p-2 sm:p-4 group relative block overflow-hidden"
  style={`--light-cursor: url("${cursorReplacement}") 16 16, auto; --dark-cursor: url("${darkCursorReplacement}") 16 16, auto;`}
>
  <a
    href={link}
    target="_blank"
    rel="noopener noreferrer"
    style="cursor: inherit;"
  >
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover rounded-md"
    />

    <!-- Overlay -->
    <div class="absolute inset-0 bg-linear-to-br bg-black/50 dark:bg-[#1a1a1a]/80 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

    <!-- Text content -->
    <div class="absolute inset-0 z-10 flex flex-col justify-end p-5 sm:p-6 opacity-0 translate-y-3 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
      <h4 class="text-lg sm:text-xl font-bold text-white">{title}</h4>

      <p class="mt-2 text-sm text-white/80">{description}</p>
    </div>
  </a>
</div>

<style>
  .special-card {
    cursor: var(--light-cursor);
  }

  :global(html.dark) .special-card {
    cursor: var(--dark-cursor);
  }
</style>
