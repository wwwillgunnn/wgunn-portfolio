---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  title: string;
  link?: string;
  variant?: "modal" | "internal" | "external";
  size?: "sm" | "md" | "lg" | "xl";
}

const { image, title, link, variant = "modal", size = "md" } = Astro.props;

const sizeStyles = {
  sm: "max-w-[200px]",
  md: "max-w-[300px]",
  lg: "max-w-[400px]",
  xl: "max-w-[600px]",
} as const;

const widths = [400, 800, 1200].filter((w) => w <= image.width);
if (widths.length === 0) widths.push(image.width);

const imgClass =
  "block w-full h-full object-cover transition-transform duration-500 hover:scale-105";
---

<div
  class={`relative w-full min-w-0 ${sizeStyles[size]} aspect-[3/4] overflow-hidden cursor-pointer`}
>
  {variant === "external" && link && (
    <a href={link} target="_blank" rel="noopener noreferrer">
      <Image
        src={image}
        alt={title}
        widths={widths}
        sizes="(max-width: 768px) 100vw, 33vw"
        class={imgClass}
        loading="lazy"
      />
    </a>
  )}
  {variant === "internal" && link && (
    <a href={link}>
      <Image
        src={image}
        alt={title}
        widths={widths}
        sizes="(max-width: 768px) 100vw, 33vw"
        class={imgClass}
        loading="lazy"
      />
    </a>
  )}
  {variant === "modal" && (
    <button
      type="button"
      class="gallery-item block w-full h-full cursor-pointer border-0 bg-transparent p-0"
      data-full={image.src}
      data-alt={title}
      aria-label={`View ${title}`}
    >
      <Image
        src={image}
        alt={title}
        widths={widths}
        sizes="(max-width: 768px) 100vw, 33vw"
        class={imgClass}
        loading="lazy"
      />
    </button>
  )}
</div>
