---
import Card from "@/components/model/Card.astro";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  title: string;
  link: string;
}

const { image, title, link } = Astro.props;
---

<div class="flex flex-col gap-4 justify-center items-center text-center">
  <Card image={image} title={title} link={link} variant="external" size="lg" />
  <span>{title}</span>
</div>
